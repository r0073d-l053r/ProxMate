# Dependencies
node_modules/

# Build output
dist/
.next/
out/

# Environment files
.env
.env.local
.env.*.local
# install.sh writes its new .env through `mktemp .env.XXXXXX` in the checkout it
# just cloned. On a normal exit the trap removes it, but a SIGKILL or an OOM kill
# leaves a file holding a freshly generated ENCRYPTION_KEY sitting untracked in a
# git tree, one `git add -A` away from being published.
.env.*
!.env.example
!.env.docker.example
# Templates are documentation, never secrets. Generalized so a new one does not
# get silently swallowed by the rule above — `mktemp .env.XXXXXX` cannot produce
# a `.example` suffix, so this does not reopen the hole the comment describes.
!.env.*.example

# Database
*.db
*.db-journal

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Prisma
backend/prisma/migrations/**/migration_lock.toml

# Logs
*.log
npm-debug.log*

# Local working notes (not for public repo)
completed-tasks.md

# TypeScript incremental build cache
*.tsbuildinfo

# Next.js boilerplate README (root README is the project README)
frontend/README.md
