# ─── ProxMate Backend Environment ─────────────────────────────
# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (SQLite file path relative to backend/)
DATABASE_URL="file:./proxmate.db"

# Encryption key for sensitive SystemConfig values. MUST be 64 hex chars
# (32 bytes) — e.g. `openssl rand -hex 32`. Left empty, a dev server generates
# one into this file on first start (production refuses to start without it);
# do NOT change after setup (stored secrets couldn't be decrypted).
ENCRYPTION_KEY=

# ─── Server binding (optional) ────────────────────────────────
# BIND_ADDR=0.0.0.0         # interface the API process listens on. Default 0.0.0.0
#                           # (required inside Docker so the proxy/frontend can reach
#                           # it). On bare metal behind a same-host proxy, set
#                           # 127.0.0.1 to listen on loopback only.

# ─── Reverse proxy (optional) ─────────────────────────────────
# TRUST_PROXY=0             # trusted proxy hops in front of the API (1 behind Caddy/nginx
#                           # or a Cloudflare Tunnel) — rate limiting keys on the real client IP
# REAL_IP_HEADER=cf-connecting-ip  # client-IP header for the audit log; honoured only when
#                           # TRUST_PROXY >= 1 (x-forwarded-for is resolved through the hop
#                           # count). Set empty to always use the socket address.

# ─── Observability (optional) ─────────────────────────────────
# LOG_LEVEL=info            # pino level: trace|debug|info|warn|error (default: debug in dev)
# METRICS_TOKEN=            # /metrics requires `Authorization: Bearer <token>` when set.
#                           # In PRODUCTION, /metrics returns 404 unless this is set
#                           # (scrape only over localhost, or set a token).

# ─── Outbound URL safety / SSRF (optional) ────────────────────
# Admin-configured webhooks + cloud-image URLs are blocked from targeting
# private/loopback/metadata addresses. Homelab installs that legitimately point
# at a LAN service (self-hosted Mattermost/ntfy, a local image mirror) can opt in:
# ALLOW_PRIVATE_OUTBOUND_URLS=true   # default false; scheme + no-credentials always enforced

# ─── Proxmox client (optional) ────────────────────────────────
# PROXMOX_TIMEOUT_MS=15000  # per-request timeout
# PROXMOX_RETRIES=2         # retries for transient failures on idempotent reads only

# ─── Rate limiting (optional) ─────────────────────────────────
# API_WRITE_RATE_LIMIT_MAX=60          # mutating requests per window per IP
# API_WRITE_RATE_LIMIT_WINDOW_MS=60000
# PUBLIC_TOKEN_RATE_LIMIT_MAX=60       # public token GETs (invite lookup, downloads) per window per IP
# PUBLIC_TOKEN_RATE_LIMIT_WINDOW_MS=900000
# SHARE_RATE_LIMIT_MAX=30               # VM share requests per window per signed-in user
# SHARE_RATE_LIMIT_WINDOW_MS=3600000

# ─── Schedules (optional, 5-field cron; unset or invalid = default) ──
# USAGE_DIGEST_CRON=0 8 * * 1   # weekly usage digest to users who opted in (Mon 08:00)
#                               # (also MATESTATE_CRON, ACCESS_EXPIRY_CRON, APPDB_BACKUP_CRON,
#                               # BALANCER_CRON, TEMPLATE_REFRESH_CRON — see DEPLOYMENT.md)

# ─── ProxMate IDE (optional) ──────────────────────────────────
# IDE_GUEST_PORT=8080       # port code-server listens on inside tenant VMs (the proxy,
#                           # the guest install and the firewall pinhole all use it)

# ─── PostgreSQL (optional, for HA / larger deployments) ───────
# To run on Postgres instead of SQLite: set the Prisma datasource provider to
# "postgresql" in backend/prisma/schema.prisma and point DATABASE_URL at it:
# DATABASE_URL="postgresql://proxmate:secret@db:5432/proxmate?schema=public"

# ─── App-database backups ─────────────────────────────────────────────────────
# Where ProxMate writes nightly snapshots of its OWN database (users, VM records,
# settings) on the HOST. Configure the schedule + retention in the app under
# Settings -> Maintenance -> App-database backups.
#
# ProxMate runs in a container and can only write to directories mounted into
# it, so this variable — not the in-app field — is what decides where the files
# really land. Creating a folder on the host without setting this does nothing.
#
# Point it at a disk that isn't the one holding the database, ideally an
# off-host mount (NFS/CIFS) so losing the host doesn't lose the backups too.
# Inside the container the directory is always /var/backups/proxmate.
#
# A snapshot is useless without the SAME ENCRYPTION_KEY — back that up separately.
PROXMATE_BACKUP_DIR=./backups

# --- Optional modules ----------------------------------------
# Comma-separated names of compiled-in modules to enable (see
# backend/src/modules/README.md). Each mounts its router at /api/ext/<name> and, if it
# ships one, has its own Prisma migrations applied to the same database at start-up,
# after core migrations. Unset (the default) = no modules, and nothing changes.
# A module named here that cannot be loaded stops the boot on purpose.
# NOTE: once a module's migrations are applied to a database, `npm run db:migrate`
# (prisma migrate dev) against that same database reports drift and offers a
# destructive reset. Use a module-free database for core schema work.
# PROXMATE_MODULES=
