# ProxMate EDU dev instance — copy to `.env.edu-dev` at the repo root and fill in.
#
#   cp deploy/.env.edu-dev.example .env.edu-dev
#   chmod 600 .env.edu-dev
#
# `.env.*` is already gitignored. Never commit the filled-in copy.

# ── REQUIRED: generate a NEW one, do not reuse production's ──────────────────
# openssl rand -hex 32
#
# It must differ from the production instance's key. Sharing it would let either
# instance decrypt the other's stored secrets (Proxmox token, SMTP password, TOTP
# seeds, tenant AI keys) — which defeats the point of running a separate testbed.
ENCRYPTION_KEY=

# ── Ports (host side; both bind to 127.0.0.1 only) ───────────────────────────
# Production on this host already uses 3100 (frontend) and 4000 (backend).
FRONTEND_PORT=3200
BACKEND_PORT=4100

# ── URLs ─────────────────────────────────────────────────────────────────────
# Reached over an SSH tunnel or Tailscale, so 127.0.0.1 is correct here.
# BACKEND_PUBLIC_URL is what gets baked into IDE gateway configs inside guests —
# it is set explicitly because header sniffing once minted broken http:// URLs
# into live guests (see the vault's ProxMate IDE note).
FRONTEND_URL=http://127.0.0.1:3200
BACKEND_PUBLIC_URL=http://127.0.0.1:4100
NEXT_PUBLIC_API_URL=http://127.0.0.1:4100/api

# ── Proxmox ──────────────────────────────────────────────────────────────────
# NOT set here. The Proxmox host, token id and secret are entered through the
# setup wizard on first run and stored AES-encrypted in this instance's own
# database. Use the dedicated dev token (root@pam!edu-dev), never production's.
#
# Verify it BEFORE first run — two of the three ways it can be broken are silent:
#   pveum user token permissions root@pam edu-dev
#   pveum user token modify root@pam edu-dev --privsep 0 --expire 0
# and confirm it can actually see guests:
#   pvesh get /cluster/resources --type vm --output-format json | head -5
# An empty VM list means the token lacks VM.Audit — the connection test will
# still pass, and the app will show nothing.
