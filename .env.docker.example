# ─── ProxMate Docker Compose configuration ────────────────────
# Copy to ".env" in this directory before running `docker compose up -d`.
#
# Two example profiles are shown below. Use the LOCAL block for a quick spin-up,
# or the PRODUCTION block (single HTTPS domain behind a reverse proxy) for a real
# deployment — passkeys, Secure cookies, and SSO all require HTTPS.

# REQUIRED. Encrypts the Proxmox token + JWT secret + SSO/SMTP secrets at rest.
# Generate once and keep it STABLE — if it changes, stored secrets can't be
# decrypted (you'd have to re-enter the Proxmox token, SSO secret, etc.).
#   openssl rand -hex 32
ENCRYPTION_KEY=

# ─── LOCAL (HTTP, two ports) ──────────────────────────────────
# Uncomment for a quick local run. Passkeys/SSO won't work over plain HTTP
# except on "localhost".
# FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# BACKEND_PUBLIC_URL=http://localhost:4000
# COOKIE_SECURE=false
# TRUST_PROXY=0
# BIND_ADDR=0.0.0.0

# ─── PRODUCTION (one HTTPS domain behind a reverse proxy) ──────
# Replace proxmate.example.com with your domain. The reverse proxy terminates
# TLS and routes "/api" → backend:4000 and everything else → frontend:3000.
FRONTEND_URL=https://proxmate.example.com
NEXT_PUBLIC_API_URL=https://proxmate.example.com/api
# Public origin used for SEO metadata (OG image + canonical + manifest URLs).
# Must be the externally reachable URL that link-preview bots can fetch.
NEXT_PUBLIC_SITE_URL=https://proxmate.example.com
BACKEND_PUBLIC_URL=https://proxmate.example.com
WEBAUTHN_RP_ID=proxmate.example.com
WEBAUTHN_ORIGIN=https://proxmate.example.com
COOKIE_SECURE=true
TRUST_PROXY=1
# Header carrying the real client IP for the audit log. Behind Cloudflare (Tunnel
# or proxy) the default "cf-connecting-ip" already works; for a plain nginx/Traefik
# proxy use "x-forwarded-for". Set empty to disable and use the raw socket IP.
# Honoured only when TRUST_PROXY >= 1 (never on a direct, proxy-less setup).
# REAL_IP_HEADER=cf-connecting-ip
# Only expose the app ports to the local reverse proxy, not the whole network.
BIND_ADDR=127.0.0.1

# Host ports the containers listen on (the reverse proxy targets these).
BACKEND_PORT=4000
FRONTEND_PORT=3000

# Optional: tune the auth rate limiter (defaults: 20 requests / 15 min / IP).
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=900000

# Optional: tune the VM-share throttle (defaults: 30 share requests / hour per
# signed-in user).
# SHARE_RATE_LIMIT_MAX=30
# SHARE_RATE_LIMIT_WINDOW_MS=3600000
# PUBLIC_TOKEN_RATE_LIMIT_MAX=60        # invite lookups and downloads per window per IP
# PUBLIC_TOKEN_RATE_LIMIT_WINDOW_MS=900000
# ALERT_COOLDOWN_MIN=60                 # minutes before a firing alert rule can fire again (min 5)

# Optional: per-account brute-force lockout (defaults: 10 failed logins lock the
# account for 15 minutes, auto-unlocking). Admins are emailed on lockout if SMTP
# is configured.
# AUTH_LOCKOUT_MAX=10
# AUTH_LOCKOUT_MINUTES=15

# Optional: expose /metrics for Prometheus. In production /metrics returns 404
# unless a token is set; scrapers must send `Authorization: Bearer <token>`.
# METRICS_TOKEN=

# Optional: where app-DATABASE backups land ON THE HOST (Settings -> Maintenance).
# ProxMate runs in a container, so it can only write to paths mounted into it: the
# container path is FIXED at /var/backups/proxmate and this chooses the host side.
# Creating a folder on the host does NOT make it reachable — it must be set here.
# Point it at a different physical disk than the database if you can.
# Changing it needs `docker compose up -d backend` (a mount is only established at
# container-create time), not a plain restart. Default: ./backups next to this file.
# PROXMATE_BACKUP_DIR=/mnt/backups/proxmate-db

# Optional: let ProxMate WRITE cloud-init "extras" snippets on demand instead of an
# admin placing each combination by hand. SNIPPET_DIR is a path INSIDE the backend
# container: bind-mount the writable snippets/ directory of a SHARED Proxmox storage
# there (in docker-compose.override.yml), and set SNIPPET_STORAGE to that storage's
# id. Without these, the matching snippet file must already exist on the target node.
# SNIPPET_DIR=/snippets
# SNIPPET_STORAGE=shared

# Optional: let tenants download guest backups (and, mounted read-write, restore an
# uploaded one). A CONTAINER path: mount your vzdump share there in
# docker-compose.override.yml. Downloads need SMTP. RESTORE_UPLOAD_MAX_GB caps an
# upload (default 50, 0 = no cap).
# BACKUP_DOWNLOAD_DIR=/backups
# RESTORE_UPLOAD_MAX_GB=50

# Optional: the one-click "Install update" button (needs the host updater units and
# the /control mount in docker-compose.override.yml — see DEPLOYMENT.md §14.3), and
# the GitHub repo the release check reads.
# SELF_UPDATE_ENABLED=false
# UPDATE_REPO=r0073d-l053r/ProxMate

# Optional: port code-server listens on inside tenant VMs for the ProxMate IDE.
# IDE_GUEST_PORT=8080

# Optional: allow admin-configured webhooks / cloud-image URLs to target private
# hosts (self-hosted Mattermost/ntfy or an image mirror on your LAN). Off by
# default (SSRF-safe); the scheme + no-credentials checks always stay enforced.
# ALLOW_PRIVATE_OUTBOUND_URLS=true

# Optional: trust a PRIVATE Proxmox CA so you can keep TLS verification ON
# (verifySsl=true) instead of disabling it. Mount the CA PEM into the backend
# (in docker-compose.override.yml, see docker-compose.override.example.yml) and
# point this at it.
# PROXMOX_CA_CERT_FILE=/certs/pve-ca.pem

# Optional: schedule overrides (5-field cron; unset or invalid uses the default).
# Shown with their defaults: app-database snapshots nightly 02:30, guest backups
# Sundays 03:00, access-window sweep hourly at :20, usage digest Mondays 08:00.
# APPDB_BACKUP_CRON=30 2 * * *
# MATESTATE_CRON=0 3 * * 0
# BALANCER_CRON=
# TEMPLATE_REFRESH_CRON=
# ACCESS_EXPIRY_CRON=20 * * * *
# USAGE_DIGEST_CRON=0 8 * * 1

# Optional: comma-separated optional modules to enable, the log level, and a
# GitHub token for the release check (higher API rate limit).
# PROXMATE_MODULES=
# LOG_LEVEL=info
# GITHUB_TOKEN=

# Optional: pin the browser CSP connect-src to your exact API + console origin.
# Blank uses a default of ('self' https: wss:) plus the NEXT_PUBLIC_API_URL origin
# and its ws/wss twin, which covers both profiles above. Tighten it in production.
# Wrap the whole value in DOUBLE quotes — compose ends a value at the closing quote
# it opened, so CSP_CONNECT_SRC='self' https://…  is read as just  self , which
# drops your origin and turns the 'self' keyword into a hostname (blocking
# everything). Keep the inner single quotes; they are part of the CSP syntax.
# CSP_CONNECT_SRC="'self' https://proxmate.example.com wss://proxmate.example.com"
